# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
build/
**/dist/
**/build/

# Environment files — NEVER commit secrets
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
.dev.vars
**/.dev.vars
!.dev.vars.example
!**/.dev.vars.example

# Service account keys & credentials
keys/
*.pem
*.key
google-sheets-sa.json
**/google-sheets-sa.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Vite cache
.vite/
**/.vite/

# Local prerender debug logs (CI regenerates dist; do not commit)
client/prerender*.txt
client/prerender*.log

# Misc
coverage/
.nyc_output/
*.tsbuildinfo

# Portfolio case-study source docs (content lives in projects.ts)
**/assets/Projects/**/*.md
**/assets/Projects/**/*.docx
**/assets/Projects/**/*.doc
**/assets/Projects/**/*.txt
