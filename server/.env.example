PORT=4000
# Set to "production" when deployed — enables strict CORS and hides DB error details
NODE_ENV=development

# Supabase — copy from Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Comma-separated list of allowed origins for CORS.
# In production this MUST be set to your real frontend URL(s) — server will reject other origins.
# In dev (NODE_ENV != production) the server falls back to allowing all if this is empty.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,https://your-domain.com

# Form notifications (optional — API still saves to Supabase form_submissions when DB is configured)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Sheets append — share the sheet with the service account email, add header row:
# Timestamp | Type | Name | Email | Phone | Company | Message | Meta
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_NAME=Submissions

# Path to service account JSON key file (recommended)
GOOGLE_APPLICATION_CREDENTIALS=./keys/google-sheets-sa.json
