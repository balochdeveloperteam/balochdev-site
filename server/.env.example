PORT=4000
# Set to "production" when deployed — enables strict CORS and hides DB error details
NODE_ENV=development

# Supabase — copy from Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Comma-separated allowed browser origins for CORS (production: set on Render).
# CORS_ALLOWED_ORIGINS is preferred; CORS_ORIGIN is still supported for backward compatibility.
# If both are empty in dev, all origins are allowed. If both empty in production, the hardcoded
# DEFAULT list in index.js applies (balochdev.com, www, balochdev-site.pages.dev, localhost).
CORS_ALLOWED_ORIGINS=https://balochdev.com,https://www.balochdev.com,https://balochdev-site.pages.dev,http://localhost:5173,http://localhost:5174

# Form notifications (optional — API still saves to Supabase form_submissions when DB is configured)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Sheets append — share the sheet with the service account email, add header row:
# Timestamp | Type | Name | Email | Phone | Company | Message | Meta
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_NAME=Submissions

# Path to service account JSON key file (recommended)
GOOGLE_APPLICATION_CREDENTIALS=./keys/google-sheets-sa.json

# Cloudinary — image uploads (API secret must never be committed)
CLOUDINARY_CLOUD_NAME=durazkwc0
CLOUDINARY_API_KEY=235297318924422
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
