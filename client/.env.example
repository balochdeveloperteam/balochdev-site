# Supabase — copy values from Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Leave empty in dev — Vite proxies /api to Node (see vite.config.js)
# Only set this if the API is on a different origin in production
# VITE_API_URL=https://api.your-domain.com
